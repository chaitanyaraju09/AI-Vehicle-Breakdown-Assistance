# ============================================================
# Vehicle Assistance Platform - Backend Configuration
# ============================================================

# Database URL: Async PostgreSQL connection string
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/breakdown_db

# Security & Authentication
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_key_for_production_use_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini API Key for AI Vehicle Diagnosis
# Get an API key from Google AI Studio: https://aistudio.google.com/
# Leave empty to run with local heuristic fallback engine
GEMINI_API_KEY=

# CORS Configuration
# Comma-separated list of allowed origins or "*" for open local development
# Examples: "http://localhost:3000,http://127.0.0.1:3000" or "*"
CORS_ORIGINS=*

# Environment: development, staging, production
ENVIRONMENT=development

